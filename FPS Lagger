-- 2. نظام التوافق الديناميكي للشبكة والـ VPN (حماية من الكراش والتوقف المفاجئ)
pcall(function()
    local Players = game:GetService("Players")
    local localPlayer = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    
    -- ضبط استقرار الشبكة ليتعامل بسلاسة مع اتصالات الـ VPN البطيئة أو العادية
    pcall(function()
        settings():GetService("NetworkSettings").IncomingReplicationLag = 0
        settings().Network.PhysicsReceiveRate = Enum.PhysicsReceiveRate.Low
    end)

    -- نظام مراقبة ذكي (Anti-Crash & Dynamic Reconnection Loop) يمنع اللعبة من الإغلاق
    local lastTick = tick()
    RunService.Heartbeat:Connect(function()
        local currentTick = tick()
        if currentTick - lastTick >= 0.5 then -- فحص سريع كل نصف ثانية
            lastTick = currentTick
            pcall(function()
                -- تنظيف الذاكرة المؤقتة لمنع حدوث Crash عند تذبذب الـ VPN أو ارتفاع البنج
                if not game:IsLoaded() then return end
            end)
        end
    end)
end)

